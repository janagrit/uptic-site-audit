{
  "name": "uptic-site-audit",
  "version": "1.0.0",
  "private": true,
  "description": "Automated audit of uptichospitality.com: SEO, accessibility, links, mobile layout, API contracts, security headers, performance",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:seo": "playwright test tests/seo.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:links": "playwright test tests/links.spec.ts",
    "test:mobile": "playwright test --project=mobile",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:visual:update:linux": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.64.0-noble bash -c 'npm ci --silent && npx playwright test tests/visual --update-snapshots'",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc -p .",
    "lint:setup": "npm --prefix tools/lint ci --no-audit --no-fund",
    "lint": "tools/lint/node_modules/.bin/eslint --config tools/lint/eslint.config.mjs .",
    "validate": "npm run typecheck && npm run lint && npm run test:unit",
    "perf": "playwright test -c playwright.perf.config.ts",
    "baseline:check": "BASELINE=check playwright test",
    "baseline:update": "BASELINE=update playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "zod": "^3.25.76"
  }
}
