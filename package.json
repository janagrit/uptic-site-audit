{
  "name": "uptic-site-audit",
  "version": "1.0.0",
  "private": true,
  "description": "Automated audit of uptichospitality.com: SEO, accessibility, links, mobile layout",
  "scripts": {
    "test": "playwright test",
    "test:seo": "playwright test tests/seo.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:links": "playwright test tests/links.spec.ts",
    "test:mobile": "playwright test tests/mobile.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "test:visual:update:linux": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.64.0-noble bash -c 'npm ci --silent && npx playwright test tests/visual.spec.ts --update-snapshots'",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --ui",
    "test:skip-bugs": "playwright test --grep-invert @bug",
    "test:bugs": "playwright test --grep @bug",
    "baseline:check": "BASELINE=check playwright test",
    "baseline:update": "BASELINE=update playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "zod": "^3.25.76"
  }
}
